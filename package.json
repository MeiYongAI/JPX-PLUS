{
  "name": "jpx-plus",
  "private": true,
  "description": "Build and offline verification tools for the standalone JPX-PLUS userscript",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build-config-manager.cjs",
    "check": "node --check JPX-PLUS.user.js && node scripts/build-config-manager.cjs --check && node scripts/check-language-packs.cjs",
    "test": "node --test --test-concurrency=2 tests/*.test.cjs",
    "profile:battle": "node scripts/profile-battle.cjs",
    "profile:battle-log": "node scripts/profile-battle-log.cjs",
    "profile:import": "node scripts/profile-config-import.cjs",
    "profile:reload": "node scripts/profile-reload.cjs",
    "profile:config-read": "node scripts/profile-config-read.cjs",
    "screenshots": "node scripts/screenshots/capture.cjs",
    "check:docs": "node scripts/check-preview.cjs"
  },
  "devDependencies": { "playwright": "1.62.1", "sharp": "0.35.5" }
}
