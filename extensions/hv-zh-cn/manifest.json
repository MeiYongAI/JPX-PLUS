{
  "manifest_version": 3,
  "name": "HentaiVerse 简体中文",
  "description": "汉化 HentaiVerse 游戏界面、战斗日志，以及论坛和拍卖站中已适配的装备名称与词缀。",
  "version": "1.2.1",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "version_name": "1.2.1 · 汉化 2026.11.20.2",
  "action": {
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "HentaiVerse 汉化 · 版本与更新"
  },
  "permissions": [
    "alarms",
    "storage"
  ],
  "background": {
    "service_worker": "updates.js"
  },
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": [
        "https://hentaiverse.org/*",
        "*://*.hentaiverse.org/*",
        "https://forums.e-hentai.org/index.php?showtopic=*",
        "https://forums.e-hentai.org/index.php?act=*",
        "https://reasoningtheory.net/*",
        "*://lisieuxing.com/*",
        "*://auction.ngnl.host/*"
      ],
      "js": [
        "translate.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
